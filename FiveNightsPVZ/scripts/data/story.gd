static func random_name(rng: RandomNumberGenerator) -> String:
	var female := rng.randf() < 0.5
	var sur: String = SURNAMES[rng.randi() % SURNAMES.size()]
	if female:
		if sur.ends_with("ий"):
			sur = sur.substr(0, sur.length() - 2) + "ая"
		else:
			sur += "а"
	var first: String = (FIRST_NAMES_F if female else FIRST_NAMES_M)[rng.randi() % (FIRST_NAMES_F.size() if female else FIRST_NAMES_M.size())]
	var mid: String = FIRST_NAMES_M[rng.randi() % FIRST_NAMES_M.size()]
	return "%s %s. %s." % [sur, first.substr(0, 1), mid.substr(0, 1)]
