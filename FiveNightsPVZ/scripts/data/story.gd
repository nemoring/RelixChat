static func intro_mail(night: int, player_name: String) -> Dictionary:
	match night:
		1:
			return {"subject": "Добро пожаловать на ночную смену", "body": "Здравствуйте, %s!\n\nВаша смена: 00:00–06:00. Оплата — 15 000 ₽ за смену.\n\nРЕГЛАМЕНТ НОЧНОЙ СМЕНЫ\n1. Входная дверь закрыта с 00:00 до 06:00. Магнитный замок не отключать.\n2. Если клиент находится в зале — выдайте заказ. Вопросов не задавать.\n3. Посылки из приёмки — отсканировать на стойке и разложить по ячейкам.\n4. Примерочные: приносите запрошенный размер. Шторку без необходимости не открывать.\n5. Руководство НИКОГДА не просит открыть дверь или выключить свет.\n6. Головной офис не проводит ночных проверок.\n7. Фонарик заряжается у рабочего места.\n\nЗадания смены — во вкладке «Задания». Невыполненное задание — нарушение. Три нарушения — увольнение.\n\nУдачной смены." % player_name}
		2:
			return {"subject": "Ночные поставки", "body": "С этой недели поставки приходят ночью. Курьер разгружается сам.\n\nС курьером не разговаривать. Если вы слышите его на складе — не выходите к нему с фонарём. Он реагирует на свет и шум.\n\nЕсли он вас заметил — уходите из его поля зрения и закрывайте за собой двери. Укрытия есть в подсобке и в туалете.\n\nНапоминаем: часть посылок может пропадать со своих мест. Ищите их."}
		3:
			return {"subject": "Порядок приёма возвратов", "body": "Возврат принимается ТОЛЬКО если одновременно:\n• заказ есть в базе (вкладка «Заказы», поиск по номеру);\n• статус заказа — «Выдан»;\n• с даты выдачи прошло не более 14 дней;\n• товар совпадает с товаром в заказе.\n\nВо всех остальных случаях — отказ.\n\nНекоторые клиенты настойчивы. Не затягивайте с решением: клиент у стойки не должен ждать.\nЕсли клиент пришёл, хотя дверь заперта, — всё равно обслужите его."}
		4:
			return {"subject": "Ночная инвентаризация. ВНИМАНИЕ: поддельные письма", "body": "Сегодня — инвентаризация. Сверьте указанные ячейки (подойдите к ячейке и выберите «Сверить»).\n\nВНИМАНИЕ. Участились поддельные письма от имени руководства. Настоящий адрес только один:\nnoch@posylka-pvz.ru\n\nПроверяйте адрес буква за буквой и время отправки. Письмо не может прийти из будущего.\nПодозрительные письма отмечайте кнопкой «Подозрительное».\n\nМы никогда не просим открыть дверь, выключить свет или прийти в техническое помещение."}
		5:
			return {"subject": "Ваш заказ", "body": "Здравствуйте, %s.\n\nВаш заказ оформлен и находится в пути. Ожидаемое время прибытия — 05:00.\n\nПолучение — в этом пункте выдачи. Ключ от технического помещения — в ящике стойки.\n\nСпасибо, что выбираете нас." % player_name}
		6:
			return {"subject": "Сверхурочная смена", "body": "Спасибо, что остались.\n\nРегламент прежний. Заказов больше, чем обычно. Все одновременно.\n\nНе задавайте вопросов."}
	return {}


