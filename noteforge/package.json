{
  "name": "noteforge",
  "productName": "NoteForge",
  "version": "0.1.0",
  "description": "NoteForge — professional piano score editor",
  "author": "NoteForge",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-electron.mjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "38.8.6",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12",
    "immer": "10.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "verovio": "6.3.0",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "type": "module",
  "dependencies": {}
}
