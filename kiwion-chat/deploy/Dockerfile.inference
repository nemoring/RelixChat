# Kiwion Inference with llama.cpp built inside the image.
# Build ON the target machine (GGML_NATIVE picks the CPU's instruction set, e.g. SSE4.2-only Pentium 4417U).
FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates && rm -rf /var/lib/apt/lists/*
ARG LLAMA_CPP_REF=785322d17f2d51e5185cf996a1f4e46d87640841
RUN git clone https://github.com/ggml-org/llama.cpp /llama.cpp && cd /llama.cpp && git checkout $LLAMA_CPP_REF \
 && cmake -B build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=ON -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF \
 && cmake --build build -j"$(nproc)" --target llama-server llama-bench

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY shared shared
COPY backend backend
COPY inference inference
COPY cli cli
RUN pip install --no-cache-dir ".[inference]"
COPY --from=build /llama.cpp/build/bin/ /app/third_party/llama.cpp/build/bin/
RUN useradd -r -u 10001 kiwion
USER kiwion
ENV KIWION_INFERENCE_HOST=0.0.0.0 KIWION_LLAMA_SERVER_BIN=/app/third_party/llama.cpp/build/bin/llama-server \
    KIWION_MODEL_PATH=/models/olmo-2-1b-instruct-Q4_K_M.gguf KIWION_LOG_DIR=/tmp/kiwion-logs
EXPOSE 8090
CMD ["python", "-m", "kiwion_inference"]
