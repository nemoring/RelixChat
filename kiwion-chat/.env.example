# ======================= Kiwion Chat configuration =======================
# Copy to .env and fill in. Never commit .env. Generate secrets with: kiwion secret

# ---------- common ----------
# shared secret for HMAC-signed backend -> inference requests (>= 32 chars, same value on both machines)
KIWION_INFERENCE_SECRET=change-me-generate-with-kiwion-secret

# ---------- backend (VPS) ----------
KIWION_ENV=development                 # production enables strict checks (secrets, SMTP)
KIWION_SECRET_KEY=                     # >= 32 random chars; used for token hashing and anti-bot challenges
KIWION_HOST=127.0.0.1
KIWION_PORT=8080
KIWION_PUBLIC_URL=http://127.0.0.1:8080   # used in e-mail links, e.g. https://chat.example.com
KIWION_DOMAIN=chat.example.com         # for deploy/Caddyfile (automatic HTTPS)
KIWION_DATABASE_URL=                   # default: sqlite file in ./data; or postgresql+psycopg://user:pass@host/kiwion
KIWION_INFERENCE_URL=http://127.0.0.1:8090   # e.g. http://10.8.0.2:8090 over WireGuard or https://... with mTLS
KIWION_INFERENCE_CA_CERT=              # mTLS: CA that signed the inference server cert (scripts/gen_certs.sh)
KIWION_INFERENCE_CLIENT_CERT=
KIWION_INFERENCE_CLIENT_KEY=
KIWION_HTTPS=0                         # 1 behind TLS: adds HSTS
KIWION_TRUSTED_PROXIES=                # e.g. 127.0.0.1 when behind Caddy/nginx (enables X-Forwarded-For)
KIWION_CORS_ORIGINS=                   # only if the web UI is served from another origin
KIWION_ADMIN_EMAILS=                   # these e-mails become admins on registration (or: python -m kiwion_backend create-admin)
KIWION_LAUNCH_AT=2027-01-15T12:00:00+03:00   # release date for the countdown page /launch
KIWION_POW_DIFFICULTY=16               # anti-bot proof-of-work for registration (bits)
KIWION_SESSION_DAYS=30

# e-mail: smtp | file (writes .eml to data/outbox — development) | console
KIWION_MAIL_MODE=file
KIWION_MAIL_FROM=Kiwion Chat <no-reply@example.com>
KIWION_SMTP_HOST=
KIWION_SMTP_PORT=587
KIWION_SMTP_USER=
KIWION_SMTP_PASSWORD=
KIWION_SMTP_STARTTLS=1

# ---------- inference node (home PC) ----------
KIWION_ENGINE=llamacpp                 # llamacpp (production). "mock" exists only for automated tests
KIWION_INFERENCE_HOST=127.0.0.1        # 10.8.0.2 = WireGuard address; never 0.0.0.0 without TLS
KIWION_INFERENCE_PORT=8090
KIWION_MODEL_PATH=                     # default: models/olmo-2-1b-instruct-Q4_K_M.gguf
KIWION_THREADS=2                       # physical cores (Pentium 4417U: 2)
KIWION_CTX=2048                        # context per request slot
KIWION_PARALLEL=1                      # simultaneous generations (1 on weak hardware)
KIWION_MAX_QUEUE=8                     # waiting requests; more -> "tired kiwi" message
KIWION_QUEUE_TIMEOUT=180
KIWION_BATCH=256
KIWION_KV_CACHE_TYPE=f16               # q8_0 halves KV-cache memory (uses flash attention)
KIWION_GPU_LAYERS=0                    # >0 only with a Vulkan build (Intel HD 620: experimental)
KIWION_MLOCK=0
KIWION_INFERENCE_SSL_CERT=             # mTLS server side (scripts/gen_certs.sh)
KIWION_INFERENCE_SSL_KEY=
KIWION_INFERENCE_SSL_CLIENT_CA=

# ---------- CLI ----------
KIWION_API_URL=http://127.0.0.1:8080   # for `kiwion chat --api-key ...`
KIWION_API_KEY=
