<?xml version="1.0" encoding="utf-8"?>
<!-- package, version and SDK levels are set by app/build.gradle (Android Studio) or by build_apk.sh -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".KiwionApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/KiwiTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/KiwiSplash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AuthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- kiwion://register?ref=KIWIXXXXXX opens registration with a referral code -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kiwion" android:host="register" />
            </intent-filter>
        </activity>

        <activity android:name=".ChatsActivity" android:exported="false" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SettingsActivity" android:exported="false" />
    </application>
</manifest>
